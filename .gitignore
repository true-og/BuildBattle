# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
# ...but the vendored dependency jars and the Gradle wrapper are tracked on purpose. Without these
# negations, bumping a vendored jar to a new filename would be silently skipped by `git add`.
!libs/*/*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# macOS system files
.DS_Store

# gradle build output files
build/
.gradle/

# eclipse project files
.settings/
.project
.classpath
.checkstyle
bin/

# IntelliJ files
.idea/
.kotlin
*.iml
*.ipr
*.iws
out/

